{
  "name": "@vg/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsx watch src/devServer.ts",
    "dev:solo": "SOLO=1 BOTS=9 tsx watch src/devServer.ts",
    "start": "tsx src/devServer.ts",
    "start:solo": "SOLO=1 BOTS=9 tsx src/devServer.ts",
    "bots": "tsx src/botsCli.ts",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vg/protocol": "workspace:*",
    "@vg/sim": "workspace:*",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/ws": "^8.5.12",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
